{
  "colors": {
    "primary": "#1B2A4A",
    "secondary": "#3B82F6",
    "accent": "#F59E0B",
    "success": "#10B981",
    "danger": "#EF4444",
    "neutral_light": "#F8FAFC",
    "neutral_dark": "#0F172A",
    "text_primary": "#1E293B",
    "text_secondary": "#64748B",
    "border": "#E2E8F0"
  },
  "typography": {
    "font_family": "Inter, system-ui, sans-serif",
    "h1": {
      "size": "3rem",
      "weight": 700,
      "line_height": 1.2
    },
    "h2": {
      "size": "2rem",
      "weight": 600,
      "line_height": 1.3
    },
    "h3": {
      "size": "1.5rem",
      "weight": 600,
      "line_height": 1.4
    },
    "body": {
      "size": "1rem",
      "weight": 400,
      "line_height": 1.6
    },
    "small": {
      "size": "0.875rem",
      "weight": 400,
      "line_height": 1.5
    }
  },
  "spacing": {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "xxl": "3rem"
  },
  "border_radius": {
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
    "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
    "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
    "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)"
  }
}
